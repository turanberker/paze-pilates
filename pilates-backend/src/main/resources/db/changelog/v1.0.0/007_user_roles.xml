<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Roller: ADMIN / INSTRUCTOR. Hoca kullanıcısı bir hoca kaydına bağlanır.
         Temiz başlangıç varsayımı: mevcut kullanıcı verisi taşınmaz. -->
    <changeSet id="1.0.0-007-user-roles" author="berker">
        <addColumn tableName="app_user">
            <column name="instructor_id" type="BIGINT"/>
            <column name="must_change_password" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <addForeignKeyConstraint baseTableName="app_user" baseColumnNames="instructor_id"
                                 constraintName="fk_app_user_instructor"
                                 referencedTableName="instructor" referencedColumnNames="id"/>
        <addUniqueConstraint tableName="app_user" columnNames="instructor_id"
                             constraintName="uk_app_user_instructor"/>
    </changeSet>

</databaseChangeLog>
