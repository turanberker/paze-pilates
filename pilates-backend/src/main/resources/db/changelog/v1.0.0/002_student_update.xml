<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Öğrenci tablosuna doğum tarihi eklendi; telefon ve notlar kısaltıldı -->
    <changeSet id="1.0.0-002" author="berker">
        <addColumn tableName="student">
            <column name="birth_date" type="DATE"/>
        </addColumn>
        <modifyDataType tableName="student" columnName="phone" newDataType="VARCHAR(20)"/>
        <modifyDataType tableName="student" columnName="notes"  newDataType="VARCHAR(500)"/>
    </changeSet>

</databaseChangeLog>
