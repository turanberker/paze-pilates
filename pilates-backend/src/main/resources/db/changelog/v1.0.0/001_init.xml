<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <!-- Uygulama kullanıcıları (yerel giriş, şifre bcrypt hash) -->
    <changeSet id="1.0.0-001" author="berker">
        <createTable tableName="app_user">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="username" type="VARCHAR(50)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_app_user_username"/>
            </column>
            <column name="password_hash" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="full_name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Stüdyo bilgileri (tek şube) -->
    <changeSet id="1.0.0-002" author="berker">
        <createTable tableName="studio">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="address" type="VARCHAR(500)"/>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Ders odaları -->
    <changeSet id="1.0.0-003" author="berker">
        <createTable tableName="room">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_room_name"/>
            </column>
            <column name="capacity" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="equipment" type="VARCHAR(1000)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>ALTER TABLE room ADD CONSTRAINT ck_room_capacity CHECK (capacity &gt; 0)</sql>
    </changeSet>

    <!-- Hocalar -->
    <changeSet id="1.0.0-004" author="berker">
        <createTable tableName="instructor">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="branch" type="VARCHAR(100)"/>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- Hocanın haftalık müsait saatleri -->
    <changeSet id="1.0.0-005" author="berker">
        <createTable tableName="instructor_availability">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="instructor_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_availability_instructor"
                             references="instructor(id)"
                             deleteCascade="true"/>
            </column>
            <column name="day_of_week" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="start_time" type="TIME">
                <constraints nullable="false"/>
            </column>
            <column name="end_time" type="TIME">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <sql>ALTER TABLE instructor_availability ADD CONSTRAINT ck_availability_time CHECK (start_time &lt; end_time)</sql>
        <createIndex tableName="instructor_availability" indexName="ix_availability_instructor">
            <column name="instructor_id"/>
        </createIndex>
    </changeSet>

    <!-- Öğrenciler -->
    <changeSet id="1.0.0-006" author="berker">
        <createTable tableName="student">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="first_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="last_name" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="phone" type="VARCHAR(30)"/>
            <column name="email" type="VARCHAR(100)"/>
            <column name="notes" type="VARCHAR(2000)"/>
            <column name="active" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP(6)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex tableName="student" indexName="ix_student_name">
            <column name="last_name"/>
            <column name="first_name"/>
        </createIndex>
        <createIndex tableName="student" indexName="ix_student_phone">
            <column name="phone"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
